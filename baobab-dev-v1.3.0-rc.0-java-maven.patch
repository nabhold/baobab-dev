+
 database:
 
   postgresql:
@@ -142,6 +164,28 @@ development:
     version: "latest"
     source: "github"
 
+  maven:
+    version: "3.9.16"
+    source: "apache"
+    # Explicit pin, NOT "latest" — unlike almost every other GitHub/npm-sourced
+    # tool in this file. Maven Central's own maven-metadata.xml currently
+    # resolves <latest>/<release> to 4.0.0-rc-6 (a pre-release of an
+    # in-development major version), which would silently pull an
+    # incompatible, non-GA toolchain into every build. iDempiere's own build
+    # requires the Maven 3.9.x line specifically (wiki.idempiere.org, see the
+    # java entry above) — 3.9.16 is the latest GA release on that line at
+    # authoring time (2026-09-01).
+    #
+    # Distribution is the official Apache tarball, architecture-independent
+    # (pure Java — no per-arch binary, unlike the Temurin JDK above), fetched
+    # from archive.apache.org (not dlcdn.apache.org, which only mirrors the
+    # single current release and would break reproducibility once 3.9.16 is
+    # superseded) at:
+    #   https://archive.apache.org/dist/maven/maven-3/${version}/binaries/apache-maven-${version}-bin.tar.gz
+    # Verified via the matching Apache-published `.sha512` sidecar (Apache
+    # publishes SHA-512 for Maven releases, not SHA-256 — see resolve.sh),
+    # per this repo's Zero-Trust Binary Downloads convention.
+
 # ------------------------------------------------------------------------------
 # NEW — frontend_tooling
